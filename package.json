{
  "name": "slopmap",
  "version": "1.2.1",
  "description": "3D architecture map of any repo or PR — changed files and their blast radius",
  "type": "module",
  "bin": {
    "slopmap": "bin/slopmap.js"
  },
  "files": [
    "bin",
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "fixture": "node scripts/make-fixture.js",
    "check:dist": "vite build && git diff --exit-code -- dist",
    "prepare": "husky; vite build"
  },
  "dependencies": {
    "3d-force-graph": "^1.73.0",
    "force-graph": "^1.51.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.40"
  },
  "license": "MIT"
}
