{
  "app/**/*.{js,vue}": [
    "eslint --fix",
    "prettier --write",
    "vitest related --run --passWithNoTests"
  ],
  "src/**/*.js": ["eslint --fix", "prettier --write", "vitest related --run --passWithNoTests"],
  "app/**/*.css": ["prettier --write"],
  "bin/**/*.js": ["eslint --fix", "prettier --write"],
  "scripts/**/*.js": ["eslint --fix", "prettier --write"],
  "app/index.html": "prettier --write",
  "*.{json,md}": "prettier --write"
}
